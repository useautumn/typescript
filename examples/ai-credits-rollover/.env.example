# Sandbox (test-mode) secret key from the Autumn dashboard.
# Never put a live key in this file.
AUTUMN_SECRET_KEY=am_sk_test_...

# The scenario refuses non-test keys by default, because it charges for
# a plan upgrade. Only if you deliberately want to run it against a live
# organisation (real charges), uncomment:
# AUTUMN_ALLOW_LIVE_KEY=1
